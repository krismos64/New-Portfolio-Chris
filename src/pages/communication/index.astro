---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Contact from '../../components/Contact.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import PhoneFeed from '../../components/com/PhoneFeed.astro';
import CampaignTimeline from '../../components/com/CampaignTimeline.astro';
import PersonaFan from '../../components/com/PersonaFan.astro';
import BeforeAfter from '../../components/com/BeforeAfter.astro';
import LaunchVideo from '../../components/com/LaunchVideo.astro';

// Deuxième casquette : communication digitale.
// Choix de Christophe (8 novembre 2026) : aucun chiffre de publication sur la
// page (vues, abonnés, impressions), des textes courts à lire en un coup d'œil
// et des animations qui racontent chaque cas. Une partie des visuels est
// générée par IA : la page le dit.
const url = 'https://krismos.fr/communication/';
const title = 'Communication digitale à Pau | Christophe Mostefaoui';
const description = "Communication digitale à Pau : visuels et reels Facebook pour une marque artisanale, campagne vidéo LinkedIn et YouTube pour un SaaS, sites et rédaction web.";

const metiers = [
  {
    titre: 'Réseaux sociaux',
    texte: "J'anime des pages Facebook et LinkedIn, dans la voix de la marque.",
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  {
    titre: 'Visuels',
    texte: "Je crée les visuels avec Canva et l'IA, adaptés à chaque réseau.",
    icon: '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
  },
  {
    titre: 'Vidéo',
    texte: "J'écris et je monte des reels et des démos avec CapCut et Final Cut Pro.",
    icon: '<rect x="2" y="5" width="15" height="14" rx="2"/><path d="m17 10 5-3v10l-5-3z"/>',
  },
  {
    titre: 'Sites et contenus',
    texte: "Je crée les sites, je soigne le référencement et j'écris les textes.",
    icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>',
  },
];

const outils = [
  { groupe: 'Visuels', items: ['Canva', 'ChatGPT', 'Codex', 'Figma'] },
  { groupe: 'Vidéo', items: ['CapCut', 'Final Cut Pro', 'Canva'] },
  { groupe: 'Animation', items: ['Claude', 'SVG et CSS'] },
  { groupe: 'Réseaux', items: ['Facebook', 'LinkedIn', 'YouTube Studio'] },
  { groupe: 'Web', items: ['HTML et CSS', 'React', 'Astro', 'Référencement'] },
  { groupe: 'Organisation', items: ['Jira', 'Confluence'] },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    "url": url,
    "name": "Communication digitale de Christophe Mostefaoui",
    "description": description,
    "inLanguage": "fr-FR",
    "isPartOf": { "@id": "https://krismos.fr/#website" },
    "about": { "@id": "https://krismos.fr/#person" },
    "keywords": "communication digitale, réseaux sociaux, Facebook, LinkedIn, YouTube, montage vidéo, Canva, CapCut, Final Cut Pro, création de visuels, rédaction web, Pau"
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "@id": `${url}#video-smartplanning`,
    "name": "SmartPlanning : vidéo de lancement en motion design",
    "description": "Vidéo verticale de 50 secondes pour LinkedIn : le planning sur Excel, le dimanche soir du manager, puis le planning d'équipe, les congés et la messagerie de SmartPlanning. Animations réalisées avec Claude, montage dans Final Cut Pro par Christophe Mostefaoui.",
    "thumbnailUrl": "https://krismos.fr/images/communication/sp-video-poster.jpg",
    "contentUrl": "https://krismos.fr/media/smartplanning-lancement.mp4",
    "uploadDate": "2026-11-07T12:00:00+01:00",
    "duration": "PT50S",
    "inLanguage": "fr-FR",
    "creator": { "@id": "https://krismos.fr/#person" },
    "isPartOf": { "@id": `${url}#page` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://krismos.fr/" },
      { "@type": "ListItem", "position": 2, "name": "Communication digitale", "item": url }
    ]
  }
];
---

<Layout title={title} description={description} url={url} image="/images/communication/og-communication.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Navigation active="communication" />

  <main id="main-content" class="com">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Portfolio</a>
      <span aria-hidden="true">·</span>
      <span aria-current="page">Communication digitale</span>
    </nav>

    <header class="hero">
      <div class="hero-text">
        <p class="eyebrow">Deuxième casquette</p>
        <h1>Communication digitale</h1>
        <p class="lead">Je conçois des produits numériques, et je sais les faire connaître.</p>
        <p class="lead-sub">Visuels, vidéos, publications et sites, pour deux lancements réels.</p>
        <ul class="chips" aria-label="Domaines">
          <li>Réseaux sociaux</li>
          <li>Visuels et vidéo</li>
          <li>Sites et contenus</li>
        </ul>
        <div class="head-links">
          <a class="btn btn-primary" href="#contact">Me contacter</a>
          <a class="btn" href="https://www.linkedin.com/in/christophemostefaoui/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
      <div class="hero-visual">
        <PhoneFeed />
      </div>
    </header>

    <section class="metiers" aria-labelledby="metiers-title">
      <h2 id="metiers-title" class="sr-only">Ce que je fais</h2>
      {metiers.map((m, i) => (
        <article class="metier fade-up" style={`--i: ${i}`}>
          <span class="metier-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={m.icon} />
          </span>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
        </article>
      ))}
    </section>

    <!-- Cas vedette : vidéo de lancement -->
    <section class="cas" aria-labelledby="cas-video">
      <p class="cas-tag cas-tag-li">LinkedIn · Motion design</p>
      <h2 id="cas-video">Une vidéo de lancement en 50 secondes</h2>
      <p class="cas-intro">
        Un format vertical pour présenter SmartPlanning : le problème, la solution, puis l'appel à l'action.
        J'ai écrit le scénario, créé les animations avec Claude et monté la vidéo dans Final Cut Pro.
      </p>

      <LaunchVideo />

      <p class="cas-links">
        <a href="https://www.linkedin.com/company/smartplanning-fr/" target="_blank" rel="noopener noreferrer">Voir la page LinkedIn</a>
        <a href="/projets/smartplanning/">L'étude de cas du logiciel</a>
      </p>
    </section>

    <!-- Cas 1 -->
    <section class="cas" aria-labelledby="cas-ls">
      <p class="cas-tag cas-tag-fb">Facebook · Marque artisanale</p>
      <h2 id="cas-ls">Lancer une marque artisanale</h2>
      <p class="cas-intro">
        Une créatrice de bijoux du Béarn vend en ligne et sur les marchés.
        J'ai mené sa campagne de Noël sur Facebook, en écrivant dans sa voix.
      </p>

      <CampaignTimeline />

      <ul class="chips chips-soft" aria-label="Mon rôle">
        <li>Plan de campagne</li>
        <li>Visuels Canva et IA</li>
        <li>Reels de lancement</li>
        <li>Événement Facebook</li>
        <li>Textes validés par la cliente</li>
      </ul>
      <p class="note">Certains visuels partent d'images générées par IA, retravaillées dans Canva.</p>
      <p class="cas-links">
        <a href="https://www.facebook.com/profile.php?id=61592696335840" target="_blank" rel="noopener noreferrer">Voir la page Facebook</a>
        <a href="/projets/lune-soleil/">Le site que j'ai développé pour elle</a>
      </p>
    </section>

    <!-- Cas 2 -->
    <section class="cas" aria-labelledby="cas-sp">
      <p class="cas-tag cas-tag-li">LinkedIn et YouTube · Logiciel B2B</p>
      <h2 id="cas-sp">Une vidéo par cible</h2>
      <p class="cas-intro">
        Un directeur, un manager et un employé n'attendent pas la même chose d'un logiciel de
        planning. Chaque démo parle de leur quotidien.
      </p>

      <PersonaFan />

      <div class="hook">
        <p class="hook-label">L'accroche de la série LinkedIn</p>
        <blockquote>« Vous gérez encore les plannings de votre équipe sur Excel ? »</blockquote>
      </div>

      <BeforeAfter />

      <ul class="chips chips-soft" aria-label="Mon rôle">
        <li>Scénario et montage</li>
        <li>Vignettes des vidéos</li>
        <li>Titres pour YouTube</li>
        <li>Série LinkedIn</li>
      </ul>
      <p class="cas-links">
        <a href="https://www.youtube.com/@SmartPlanning-x2c" target="_blank" rel="noopener noreferrer">Voir la chaîne YouTube</a>
        <a href="https://www.linkedin.com/company/smartplanning-fr/" target="_blank" rel="noopener noreferrer">Voir la page LinkedIn</a>
      </p>
    </section>

    <!-- Cas 3 -->
    <section class="cas" aria-labelledby="cas-web">
      <p class="cas-tag">Web et rédaction</p>
      <h2 id="cas-web">Des sites et des textes</h2>
      <div class="liens">
        <a class="lien fade-up" href="/projets/">
          <strong>Sites et projets</strong>
          <span>Boutique en ligne, sites vitrines, référencement local.</span>
        </a>
        <a class="lien fade-up" href="/blog/claude-code-04-preuve-par-mutation/">
          <strong>Expliquer simplement</strong>
          <span>Un article qui rend une notion technique claire pour un débutant.</span>
        </a>
        <a class="lien fade-up" href="/projets/lune-soleil/">
          <strong>Schémas animés</strong>
          <span>Des animations qui expliquent un projet en quelques secondes.</span>
        </a>
        <a class="lien fade-up" href="/projets/portfolio/">
          <strong>Référencement mesuré</strong>
          <span>L'étude de cas de ce site : indexation, vitesse et assistants IA.</span>
        </a>
      </div>
    </section>

    <section class="methode" aria-labelledby="methode-title">
      <p class="cas-tag">Méthode</p>
      <h2 id="methode-title">Comment je mène une campagne</h2>
      <ol class="etapes">
        <li class="fade-up"><strong>Comprendre la marque</strong><span>Ce qu'elle veut annoncer, et avec quels mots elle parle.</span></li>
        <li class="fade-up"><strong>Choisir la cible</strong><span>Un message par public, écrit pour son quotidien.</span></li>
        <li class="fade-up"><strong>Planifier</strong><span>Un calendrier daté : préparer, créer l'attente, annoncer, faire réagir.</span></li>
        <li class="fade-up"><strong>Produire</strong><span>Textes, visuels et vidéos au format de chaque réseau.</span></li>
        <li class="fade-up"><strong>Faire valider, puis publier</strong><span>Le client relit chaque texte avant sa mise en ligne.</span></li>
      </ol>
    </section>

    <section class="outils" aria-labelledby="outils-title">
      <h2 id="outils-title">Outils utilisés sur ces projets</h2>
      <div class="outils-grid">
        {outils.map((o) => (
          <div class="outil">
            <span class="outil-groupe">{o.groupe}</span>
            <ul class="chips chips-soft">
              {o.items.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <Contact />
  </main>
  <ScrollReveal />
</Layout>

<style>
  .com {
    position: relative;
    z-index: 2;
    max-width: 1040px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 2rem) 1.25rem 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 2rem; }
  .breadcrumb a { color: var(--text-secondary); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }

  /* ===== En-tête ===== */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--purple) 80%, white);
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--text);
    margin-bottom: 1.25rem;
  }
  .lead { font-size: 1.25rem; line-height: 1.45; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; }
  .lead-sub { font-size: 1rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 1.25rem; }

  .chips { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li {
    padding: 0.35rem 0.8rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 100px;
    color: var(--text);
    background: color-mix(in srgb, var(--purple) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--purple) 35%, var(--border));
  }
  .chips-soft li {
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--border);
  }

  .head-links, .cas-links { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.15rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .btn:hover { color: var(--text); border-color: var(--border-light); }
  .btn-primary { background: var(--accent-btn); border-color: var(--accent-btn); color: white; }
  .btn-primary:hover { background: var(--accent-btn-hover); border-color: var(--accent-btn-hover); color: white; }

  /* ===== Métiers ===== */
  .metiers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .metier {
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), transform var(--transition);
  }
  .metier:hover { border-color: color-mix(in srgb, var(--purple) 50%, var(--border)); transform: translateY(-3px); }
  .metier-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 0.85rem;
    border-radius: 12px;
    color: color-mix(in srgb, var(--purple) 80%, white);
    background: color-mix(in srgb, var(--purple) 15%, transparent);
  }
  .metier h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.35rem; }
  .metier p { font-size: 0.875rem; line-height: 1.55; color: var(--text-secondary); }
  .metier.sr-visible { animation: metier-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards; animation-delay: calc(var(--i) * 110ms); }
  @keyframes metier-in { from { opacity: 0; transform: translateY(20px); } }
  @media (prefers-reduced-motion: reduce) { .metier.sr-visible { animation: none; } }

  /* ===== Méthode ===== */
  .methode { padding: 3.5rem 0 1rem; border-top: 1px solid var(--border); margin-top: 2.5rem; }
  .etapes {
    list-style: none;
    counter-reset: etape;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .etapes li {
    counter-increment: etape;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .etapes li::before {
    content: counter(etape);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--purple) 80%, white);
  }
  .etapes strong { font-size: 0.9375rem; font-weight: 700; color: var(--text); }
  .etapes span { font-size: 0.8125rem; line-height: 1.5; color: var(--text-secondary); }
  @media (max-width: 900px) { .etapes { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .etapes { grid-template-columns: 1fr; } }

  /* ===== Cas ===== */
  .cas { padding: 3.5rem 0; border-top: 1px solid var(--border); margin-top: 2.5rem; }
  .cas-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .cas-tag-fb { color: #93b4f5; }
  .cas-tag-li { color: #7cc4f0; }
  .cas h2 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .cas-intro { max-width: 620px; font-size: 1.0625rem; line-height: 1.65; color: var(--text-secondary); }
  .note { margin: -0.5rem 0 1rem; font-size: 0.8125rem; color: var(--text-muted); }
  .cas-links a {
    font-size: 0.9rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--accent) 85%, white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hook {
    max-width: 640px;
    margin: 1rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .hook-label { font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.3rem; }
  .hook blockquote { margin: 0; font-size: 1.125rem; font-weight: 700; line-height: 1.4; color: var(--text); }

  .liens { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.25rem; }
  .lien {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), transform var(--transition);
  }
  .lien:hover { border-color: var(--accent); transform: translateY(-3px); color: inherit; }
  .lien strong { color: var(--text); }
  .lien span { font-size: 0.875rem; line-height: 1.5; color: var(--text-secondary); }

  /* ===== Outils ===== */
  .outils {
    margin: 1rem 0 2rem;
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .outils h2 { font-size: 1.125rem; font-weight: 700; color: var(--text); margin-bottom: 1.25rem; }
  .outils-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem 1.5rem; }
  .outil-groupe {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .outil .chips { margin: 0; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; text-align: left; }
    .metiers { grid-template-columns: repeat(2, 1fr); }
    .liens { grid-template-columns: 1fr; }
    .outils-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .metiers, .outils-grid { grid-template-columns: 1fr; }
    .outils { padding: 1.25rem; }
  }
</style>
