---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Projects from '../../components/Projects.astro';
import Contact from '../../components/Contact.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { projects } from '../../data/projects';

const url = 'https://krismos.fr/projets/';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    "url": url,
    "name": "Projets web et SaaS de Christophe Mostefaoui",
    "inLanguage": "fr-FR",
    "isPartOf": { "@id": "https://krismos.fr/#website" },
    "about": { "@id": "https://krismos.fr/#person" },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": projects.length,
      "itemListElement": projects.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "CreativeWork",
          "name": p.title,
          "description": p.tagline,
          "url": p.caseStudy ? new URL(p.caseStudy, 'https://krismos.fr').href : p.links.website,
          "creator": { "@id": "https://krismos.fr/#person" },
          "keywords": p.tech.join(', '),
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://krismos.fr/" },
      { "@type": "ListItem", "position": 2, "name": "Projets", "item": url },
    ],
  },
];
---

<Layout
  title="Projets web et SaaS | Christophe Mostefaoui, développeur à Pau"
  description="Projets de Christophe Mostefaoui, développeur à Pau : le SaaS SmartPlanning en Next.js, la boutique Lune-Soleil, Staka Livres et des sites vitrines."
  url={url}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Navigation active="projets" />
  <main id="main-content">
    <Projects variant="full" />
    <section class="this-site fade-up" aria-labelledby="this-site-title">
      <h2 id="this-site-title">Et ce site ?</h2>
      <p>Ce portfolio a aussi son étude de cas : référencement, vitesse d'affichage et lisibilité par les assistants IA, mesurés puis corrigés.</p>
      <a href="/projets/portfolio/">
        Lire l'étude de cas du portfolio
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </section>
    <Contact />
  </main>
  <ScrollReveal />
</Layout>

<style>
  .this-site {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    text-align: center;
  }
  .this-site h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .this-site p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }
  .this-site a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  .this-site a:hover,
  .this-site a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-05);
  }
</style>
