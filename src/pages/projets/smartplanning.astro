const articles = [
  { slug: '01-analyse-des-besoins', title: 'Analyse des besoins : comprendre avant de coder' },
  { slug: '02-gestion-de-projet-agile', title: 'Gestion de projet Agile : organiser le développement' },
  { slug: '03-conception-base-de-donnees', title: 'Conception de la base de données : modéliser un SaaS multi-tenant' },
  { slug: '04-architecture-nextjs-saas', title: 'Architecture Next.js : structurer un SaaS scalable' },
  { slug: '05-developpement-fonctionnalites', title: 'Développement des fonctionnalités : problèmes et solutions' },
  { slug: '06-strategie-de-tests', title: 'Stratégie de tests : garantir la qualité' },
