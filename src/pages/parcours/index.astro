---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import About from '../../components/About.astro';
import Skills from '../../components/Skills.astro';
import Process from '../../components/Process.astro';
import Contact from '../../components/Contact.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';

const url = 'https://krismos.fr/parcours/';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${url}#page`,
    "url": url,
    "name": "Parcours et compétences de Christophe Mostefaoui",
    "inLanguage": "fr-FR",
    "isPartOf": { "@id": "https://krismos.fr/#website" },
    "about": { "@id": "https://krismos.fr/#person" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://krismos.fr/" },
      { "@type": "ListItem", "position": 2, "name": "Parcours", "item": url },
    ],
  },
];
---

<Layout
  title="Parcours et compétences | Christophe Mostefaoui, développeur à Pau"
  description="Parcours de Christophe Mostefaoui : titre CDA spécialité IA, titre DWWM, 12 ans en commerce tech. Compétences Next.js, React, TypeScript, PostgreSQL et Docker."
  url={url}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Navigation active="parcours" />
  <main id="main-content">
    <header class="page-head">
      <h1 class="section-title">Parcours et compétences</h1>
      <p class="page-intro">
        Douze ans de relation client dans le commerce tech, puis une reconversion validée par
        deux titres professionnels, dont celui de Concepteur Développeur d'Applications
        spécialité IA. Voici mes formations, les technologies que j'utilise et la façon dont
        je mène un projet.
      </p>
    </header>
    <About />
    <section class="team fade-up" aria-labelledby="team-title">
      <h2 id="team-title" class="section-title">Travail en équipe</h2>
      <p class="team-intro">
        Pendant ma formation CDA, j'ai développé en équipe de trois une application commandée
        par l'association IA Pau. Des étudiants d'école de commerce y choisissent une IA,
        rédigent leurs prompts et répondent à des questions. Leurs formateurs analysent et
        évaluent ces prompts depuis un espace d'administration.
      </p>
      <dl class="team-facts">
        <div><dt>Mon rôle</dt><dd>Le frontend en Next.js, l'intégration des IA proposées dans l'application et la documentation.</dd></div>
        <div><dt>Méthode</dt><dd>Branches Git, pull requests, revues de code et point quotidien.</dd></div>
        <div><dt>Ce que j'en retiens</dt><dd>Résoudre des conflits Git, mieux communiquer, et ce qu'une relecture apporte avant de fusionner.</dd></div>
      </dl>
    </section>
    <Skills />
    <Process />
    <Contact />
  </main>
  <ScrollReveal />
</Layout>

<style>
  .page-head {
    max-width: 720px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 3rem) 1.5rem 0;
    text-align: center;
  }
  .page-head .section-title {
    margin-bottom: 1rem;
  }
  .team {
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem 1.5rem 2rem;
  }
  .team-intro {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }
  .team-facts {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .team-facts div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0.875rem 1.125rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .team-facts dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }
  .team-facts dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .team-facts div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
  .page-intro {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
</style>
