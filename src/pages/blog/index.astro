---
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import { getCollection } from 'astro:content';
import { series as allSeries, seriesOrder } from '../../data/series';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const seriesList = seriesOrder.map((key) => {
  const posts = allPosts
    .filter((post) => post.data.series === key)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return {
    meta: allSeries[key],
    count: posts.length,
    latest: posts[0] ?? null,
  };
}).filter((entry) => entry.count > 0);

const totalPosts = allPosts.length;
---

<Layout
  title="Blog technique : SaaS Next.js et agents de code | Christophe Mostefaoui"
  description="Deux séries d'articles techniques : la conception du SaaS SmartPlanning de A à Z, et l'encadrement d'un agent de code sur un projet e-commerce réel."
  url="https://krismos.fr/blog/"
>
  <BlogNav activeLink="blog" />

  <!-- JSON-LD : le blog et ses séries -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Blog technique de Christophe Mostefaoui",
    "description": "Séries d'articles sur la conception d'un SaaS Next.js et sur l'encadrement des agents de code",
    "url": "https://krismos.fr/blog/",
    "author": {
      "@type": "Person",
      "name": "Christophe Mostefaoui",
      "url": "https://krismos.fr/"
    },
    "hasPart": seriesList.map((entry) => ({
      "@type": "Blog",
      "name": entry.meta.title,
      "description": entry.meta.description,
      "url": entry.meta.url
    }))
  })} />

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://krismos.fr/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://krismos.fr/blog/" }
    ]
  })} />

  <main id="main-content" class="hub">
    <header class="hub-header">
      <span class="hub-label">Blog technique</span>
      <h1 class="hub-title">Deux projets, racontés de l'intérieur</h1>
      <p class="hub-description">
        Ce que je construis et comment je le construis : la conception complète d'un
        SaaS de gestion d'équipes, et la façon dont j'encadre un agent de code sur un
        projet e-commerce en cours. Décisions, incidents et code réel.
      </p>
      <p class="hub-count">{totalPosts} articles répartis en {seriesList.length} séries</p>
    </header>

    <div class="series-grid">
      {seriesList.map((entry) => (
        <a href={`/blog/${entry.meta.key}/`} class="series-card" style={`--series-accent: ${entry.meta.accent}`}>
          <div class="series-cover">
            <img
              src={entry.meta.image}
              alt={entry.meta.imageAlt}
              class="series-cover-img"
              width="800"
              height="420"
              loading="lazy"
            />
          </div>
          <div class="series-body">
            <span class="series-count">{entry.count} {entry.count > 1 ? 'articles' : 'article'}</span>
            <h2 class="series-title">{entry.meta.title}</h2>
            <p class="series-tagline">{entry.meta.tagline}</p>
            {entry.latest && (
              <p class="series-latest">
                <span class="series-latest-label">Dernier publié</span>
                <span class="series-latest-title">{entry.latest.data.title}</span>
              </p>
            )}
            <span class="series-cta">
              Lire la série
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    {seriesList.length === 0 && (
      <div class="empty-state">
        <p>Les articles arrivent bientôt.</p>
      </div>
    )}
  </main>
</Layout>

<style>
  .hub {
    padding-top: calc(var(--nav-height) + 2rem);
    max-width: 900px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-bottom: 4rem;
  }

  .hub-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hub-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.75rem;
    display: block;
  }

  .hub-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .hub-description {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto;
  }

  .hub-count {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  /* === Cartes de série === */
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .series-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .series-card:hover {
    border-color: color-mix(in srgb, var(--series-accent) 45%, var(--border));
    transform: translateY(-3px);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
    color: inherit;
  }

  .series-card:focus-visible {
    outline: 2px solid var(--series-accent);
    outline-offset: 3px;
  }

  .series-cover {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .series-cover-img {
    width: 100%;
    height: auto;
    aspect-ratio: 40 / 21;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .series-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .series-count {
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    /* 15 % de blanc pour tenir 4,5:1 (WCAG AA) sur le fond des cartes */
    color: color-mix(in srgb, var(--series-accent) 85%, white);
    margin-bottom: 0.625rem;
  }

  .series-title {
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .series-tagline {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .series-latest {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.875rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1.25rem;
  }

  .series-latest-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .series-latest-title {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .series-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--series-accent) 85%, white);
  }

  .series-cta svg {
    transition: transform var(--transition);
  }

  .series-card:hover .series-cta svg {
    transform: translateX(3px);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .series-grid {
      grid-template-columns: 1fr;
    }

    .series-body {
      padding: 1.25rem;
    }
  }
</style>
