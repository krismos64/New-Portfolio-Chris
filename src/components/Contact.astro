---
// Section Contact, en bas de l'accueil, de /projets/, de /parcours/ et de /communication/.
// L'ancre #contact existe donc sur chaque page qui l'inclut.
---

<section id="contact" class="contact">
  <h2 class="section-title">Contact</h2>
  <p class="contact-intro">
    Un projet en tête ? Faisons un <code>git merge</code> de nos idées.
  </p>
  <div class="contact-links">
    <a href="https://christophe-dev-freelance.fr/" target="_blank" rel="noopener noreferrer" class="contact-card contact-card-highlight">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <span class="contact-label">Site freelance</span>
      <span class="contact-value">christophe-dev-freelance.fr</span>
      <span class="contact-arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
    </a>
    <!-- Le lien ouvre la messagerie ; le bouton distinct copie l'adresse, pour
         les visiteurs sans client mail configuré. Confirmation annoncée aux
         lecteurs d'écran (aria-live). -->
    <div class="contact-row">
      <a href="mailto:christophe.mostefaoui.dev@gmail.com" class="contact-card">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span class="contact-label">Email</span>
        <span class="contact-value">christophe.mostefaoui.dev@gmail.com</span>
        <span class="contact-arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </a>
      <button type="button" class="contact-copy" data-copy="christophe.mostefaoui.dev@gmail.com" aria-label="Copier l'adresse email">
        <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" pathLength="1"/></svg>
        <span class="contact-copy-label">Copier</span>
      </button>
    </div>
    <a href="https://www.linkedin.com/in/christophemostefaoui/" target="_blank" rel="noopener noreferrer" class="contact-card">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      <span class="contact-label">LinkedIn</span>
      <span class="contact-value">christophemostefaoui</span>
      <span class="contact-arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
    </a>
    <a href="https://github.com/krismos64" target="_blank" rel="noopener noreferrer" class="contact-card">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      <span class="contact-label">GitHub</span>
      <span class="contact-value">krismos64</span>
      <span class="contact-arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
    </a>
  </div>
  <p class="contact-status" role="status" aria-live="polite" data-copy-status></p>
</section>

<style>
  .contact {
    padding: 5rem 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-intro {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: 2.5rem;
  }

  /* code styled globally in Layout.astro */

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-row {
    display: flex;
    gap: 0.75rem;
  }
  .contact-row .contact-card { flex: 1; min-width: 0; }

  .contact-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 3rem 1.125rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition), background var(--transition);
    text-decoration: none;
    color: inherit;
  }
  .contact-card:hover {
    border-color: var(--border-light);
    background: var(--bg-card-hover);
    color: inherit;
  }

  .contact-card-highlight {
    border-color: var(--accent-30);
    background: var(--accent-05);
  }
  .contact-card-highlight:hover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }
  .contact-card-highlight svg {
    color: var(--accent);
  }

  .contact-card svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .contact-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    min-width: 70px;
  }

  .contact-value {
    font-size: 0.875rem;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .contact-card {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .contact-value {
      width: 100%;
      padding-left: 2.25rem;
      font-size: 0.8125rem;
    }
  }

  /* Flèche qui glisse au survol et au focus clavier */
  .contact-arrow {
    position: absolute;
    right: 1.25rem;
    top: 50%;
    display: grid;
    color: var(--text-muted);
    transform: translate(-4px, -50%);
    opacity: 0.5;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease, color 0.3s ease;
  }
  .contact-card:hover .contact-arrow,
  .contact-card:focus-visible .contact-arrow {
    transform: translate(2px, -50%);
    opacity: 1;
    color: var(--accent);
  }
  .contact-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Bouton Copier : l'icône bascule vers une coche qui se trace */
  .contact-copy {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1rem;
    font: 600 0.8125rem 'Inter Variable', sans-serif;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition), transform 0.15s ease;
  }
  .contact-copy:hover { color: var(--text); border-color: var(--border-light); }
  .contact-copy:active { transform: scale(0.96); }
  .contact-copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .contact-copy .icon-check { display: none; }
  .contact-copy.is-copied { color: var(--green); border-color: color-mix(in srgb, var(--green) 50%, var(--border)); }
  .contact-copy.is-copied .icon-copy { display: none; }
  .contact-copy.is-copied .icon-check { display: block; }
  .contact-copy.is-copied .icon-check polyline {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: contact-check 0.4s ease forwards;
  }
  @keyframes contact-check { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .contact-copy.is-copied .icon-check polyline { animation: none; stroke-dashoffset: 0; }
  }

  .contact-status {
    min-height: 1.25rem;
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--green);
  }

  @media (max-width: 640px) {
    .contact-row { flex-direction: column; gap: 0.5rem; }
    .contact-copy { justify-content: center; padding: 0.7rem 1rem; }
    .contact-arrow { top: 1.4rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    const label = btn.querySelector<HTMLElement>('.contact-copy-label');
    let timer = 0;
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(value);
        ok = true;
      } catch {
        ok = false;
      }
      if (status) status.textContent = ok ? 'Adresse email copiée.' : `Copie impossible : ${value}`;
      if (ok) {
        btn.classList.add('is-copied');
        if (label) label.textContent = 'Copiée';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.classList.remove('is-copied');
          if (label) label.textContent = 'Copier';
          if (status) status.textContent = '';
        }, 2500);
      }
    });
  });
</script>
