---
import { projects } from '../data/projects';

interface Props {
  /** home : projet phare + 2 cartes et lien vers /projets/ ; full : page /projets/ complète */
  variant?: 'home' | 'full';
}
const { variant = 'full' } = Astro.props;
const isHome = variant === 'home';

const featured = projects[0]; // SmartPlanning
const allMain = projects.slice(1).filter((p) => !p.secondary);
const others = isHome ? allMain.slice(0, 2) : allMain;
const secondary = isHome ? [] : projects.filter((p) => p.secondary);

// Sur /projets/, le titre de page est le h1 : les titres de cartes descendent d'un cran
const H = isHome ? 'h3' : 'h2';
const HSub = isHome ? 'h4' : 'h3';

// Chaque maquette existe en 1200 px et en 800 px (suffixe -800)
const srcset = (src: string) => `${src.replace('.webp', '-800.webp')} 800w, ${src} 1200w`;
const alt = (p: { title: string }) => `Le site ${p.title} affiché sur un ordinateur portable et un smartphone`;
---

<section id="projects" class={isHome ? 'projects-home' : 'projects-full'}>
  {isHome ? (
    <h2 class="section-title">Projets phares</h2>
  ) : (
    <header class="page-head">
      <h1 class="section-title">Projets web et SaaS</h1>
      <p class="page-intro">
        Un SaaS en production, une boutique e-commerce pour une cliente, une plateforme
        d'édition, puis les sites vitrines et projets de formation. Chaque carte renvoie
        au site en ligne et, quand il est public, au code source.
      </p>
    </header>
  )}

  <!-- Projet phare : SmartPlanning -->
  <div class="featured fade-up">
    {featured.caseStudy && (
      <a href={featured.caseStudy} class="case-badge case-badge-featured">
        <span class="case-badge-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg></span>
        Étude de cas animée
      </a>
    )}
    <a href={featured.links.website} target="_blank" rel="noopener noreferrer" class="featured-image-link" aria-label={`Voir ${featured.title}`}>
      <img src={featured.image} srcset={srcset(featured.image)} sizes="(max-width: 900px) 100vw, 600px" width="1200" height="675" alt={alt(featured)} loading="lazy" decoding="async" />
      <div class="featured-overlay">
        <span class="featured-cta">
          Voir le projet
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </span>
      </div>
    </a>
    <div class="featured-body">
      <div class="featured-top">
        {featured.badge && <span class="badge badge-blue">{featured.badge}</span>}
        <div class="featured-social-pills">
          {featured.links.linkedin && (
            <a
              href={featured.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill social-pill-linkedin"
              aria-label={`Page LinkedIn officielle de ${featured.title}`}
              title="Page LinkedIn SmartPlanning"
            >
              <span class="social-pill-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.852 3.37-1.852 3.601 0 4.267 2.37 4.267 5.455v6.288zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </span>
              <span class="social-pill-label">LinkedIn</span>
              <span class="social-pill-dot" aria-hidden="true"></span>
            </a>
          )}
          {featured.links.youtube && (
            <a
              href={featured.links.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill social-pill-youtube"
              aria-label={`Chaîne YouTube officielle de ${featured.title}`}
              title="Chaîne YouTube SmartPlanning"
            >
              <span class="social-pill-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </span>
              <span class="social-pill-label">YouTube</span>
              <span class="social-pill-dot" aria-hidden="true"></span>
            </a>
          )}
        </div>
      </div>
      <H class="featured-title">{featured.title}</H>
      <p class="featured-tagline">{featured.tagline}</p>
      <div class="featured-tech">
        {featured.tech.map((t) => (
          <span class="tech-pill">{t}</span>
        ))}
      </div>
      <div class="featured-highlights">
        {featured.highlights.map((h) => (
          <div class="highlight-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{h}</span>
          </div>
        ))}
      </div>

      <a href={featured.caseStudy} class="case-link">
        Lire l'étude de cas : décisions, tests et retours d'expérience
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>

      <div class="featured-blog-cta">
        <a href="/blog/smartplanning/" class="blog-cta-btn">
          <span class="blog-cta-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </span>
          <span class="blog-cta-content">
            <span class="blog-cta-label">Comment j'ai conçu SmartPlanning</span>
            <span class="blog-cta-sub">8 articles · Du cahier des charges au déploiement</span>
          </span>
          <svg class="blog-cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Autres projets -->
  <div class="projects-grid">
    {others.map((project, index) => (
      <article class="card fade-up" style={`--i: ${index % 2}`}>
        <div class="card-image">
          {project.caseStudy && (
            <a href={project.caseStudy} class="case-badge">
              <span class="case-badge-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg></span>
              Étude de cas animée
            </a>
          )}
          <img src={project.image} srcset={srcset(project.image)} sizes="(max-width: 640px) 100vw, 560px" width="1200" height="675" alt={alt(project)} loading="lazy" decoding="async" />
          {project.badge && (
            <span class={`badge badge-${project.badgeColor}`}>{project.badge}</span>
          )}
        </div>
        <div class="card-body">
          <H class="card-title">{project.title}</H>
          <p class="card-tagline">{project.tagline}</p>
          <div class="card-tech">
            {project.tech.slice(0, 4).map((t) => (
              <span class="tech-pill">{t}</span>
            ))}
            {project.tech.length > 4 && (
              <span class="tech-pill tech-more">+{project.tech.length - 4}</span>
            )}
          </div>
          <div class="card-links">
            {project.caseStudy && (
              <a href={project.caseStudy} class="card-link card-link-case">
                Étude de cas
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            )}
            {project.links.website && (
              <a href={project.links.website} target="_blank" rel="noopener noreferrer" class="card-link card-link-primary">
                Voir le site
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </a>
            )}
            {project.links.github && (
              <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="card-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                Code
              </a>
            )}
            {project.links.facebook && (
              <a href={project.links.facebook} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`Page Facebook de ${project.title}`}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.026 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.931-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
                Facebook
              </a>
            )}
            {project.links.video && (
              <a href={project.links.video} target="_blank" rel="noopener noreferrer" class="card-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Démo
              </a>
            )}
            {!project.links.website && !project.links.github && !project.links.video && !project.links.facebook && project.status && (
              <p class="card-status">
                <span class="card-status-line">
                  <span class="card-status-dot" aria-hidden="true"></span>
                  {project.status}
                </span>
                {project.upcomingDomain && (
                  <span class="card-status-domain">{project.upcomingDomain}</span>
                )}
              </p>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  {isHome && (
    <div class="all-projects fade-up">
      <a href="/projets/" class="all-projects-link">
        Voir les {projects.length} projets
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  )}

  <!-- Réalisations secondaires : sites vitrines clients, projet de formation, démo.
       Cartes compactes sous la grille, pour que les projets techniques passent devant -->
  {secondary.length > 0 && <div class="more" aria-labelledby="more-title">
    <div class="more-head fade-up">
      <H id="more-title" class="more-title">Autres réalisations</H>
      <p class="more-intro">Sites vitrines livrés à des clients, projet d'examen et démo, en HTML, PHP ou Symfony.</p>
    </div>
    <div class="more-grid">
      {secondary.map((project, index) => (
        <article class="card card-compact fade-up" style={`--i: ${index % 3}`}>
          <div class="card-image">
            <img src={project.image} srcset={srcset(project.image)} sizes="(max-width: 640px) 100vw, 380px" width="1200" height="675" alt={alt(project)} loading="lazy" decoding="async" />
            {project.badge && (
              <span class={`badge badge-${project.badgeColor}`}>{project.badge}</span>
            )}
          </div>
          <div class="card-body">
            <HSub class="card-title">{project.title}</HSub>
            <p class="card-tagline">{project.tagline}</p>
            <p class="card-desc">{project.description}</p>
            <div class="card-tech">
              {project.tech.map((t) => (
                <span class="tech-pill">{t}</span>
              ))}
            </div>
            <div class="card-links">
              {project.links.website && (
                <a href={project.links.website} target="_blank" rel="noopener noreferrer" class="card-link card-link-primary">
                  Voir le site
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </a>
              )}
              {project.links.github && (
                <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`Code source de ${project.title} sur GitHub`}>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                  Code
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>}

</section>

<style>
  #projects {
    padding: 5rem 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  #projects.projects-full {
    padding-top: calc(var(--nav-height) + 3rem);
  }
  .page-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .page-head .section-title {
    margin-bottom: 1rem;
  }
  .page-intro {
    max-width: 640px;
    margin: 0 auto;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .all-projects {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .all-projects-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  .all-projects-link:hover {
    border-color: var(--accent);
    background: var(--accent-05);
    color: var(--text);
  }
  .all-projects-link svg {
    transition: transform var(--transition);
  }
  .all-projects-link:hover svg {
    transform: translateX(3px);
  }

  /* ===== Badge « Étude de cas animée » =====
     Signale les projets qui ont une étude de cas avec schéma animé. Il entre
     une fois quand la carte apparaît (classe .sr-visible de ScrollReveal),
     puis un reflet le traverse une seule fois. Lien vers l'étude de cas,
     accessible au clavier. Mouvement réduit : badge fixe (règle globale). */
  .case-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem 0.35rem 0.4rem;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    border-radius: 100px;
    background: linear-gradient(135deg, var(--accent-btn), #7c3aed);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .case-badge:hover,
  .case-badge:focus-visible {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.5);
  }
  .case-badge:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .case-badge-icon {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }
  .case-badge-icon svg { margin-left: 1px; }
  .case-badge::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.45) 50%, transparent 70%);
    transform: translateX(-120%);
    pointer-events: none;
  }
  .sr-visible .case-badge {
    animation: case-badge-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.45s backwards;
  }
  .sr-visible .case-badge::after {
    animation: case-badge-shine 1s ease 1.1s forwards;
  }
  .sr-visible .case-badge .case-badge-icon {
    animation: case-badge-pulse 0.9s ease 1s;
  }
  @keyframes case-badge-in { from { opacity: 0; transform: translateX(16px) scale(0.9); } }
  @keyframes case-badge-shine { to { transform: translateX(120%); } }
  @keyframes case-badge-pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6); }
    100% { box-shadow: 0 0 0 10px transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sr-visible .case-badge,
    .sr-visible .case-badge::after,
    .sr-visible .case-badge .case-badge-icon { animation: none !important; }
  }
  .featured { position: relative; }
  .case-badge-featured { top: 2.25rem; left: 2.25rem; right: auto; }
  @media (max-width: 900px) {
    .case-badge-featured { top: 1.75rem; left: 1.75rem; }
  }

  /* ===== FEATURED PROJECT ===== */
  .featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 2rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .featured:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 8px 40px rgba(59, 130, 246, 0.1);
  }

  /* Maquette 16:9 posée dans la carte, centrée verticalement face au texte */
  .featured-image-link {
    position: relative;
    display: block;
    align-self: center;
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0 1.5rem 1.5rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
    text-decoration: none;
  }
  .featured-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .featured:hover .featured-image-link img {
    transform: scale(1.03);
  }
  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }
  .featured:hover .featured-overlay {
    opacity: 1;
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: var(--accent-btn);
    color: white;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .featured-body {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  .featured-top {
    display: flex;
    align-items: center;
