---
// Les pages du blog utilisent la même navigation que le reste du site
// (Projets, Parcours, Blog, Contact). Le contact vit sur l'accueil.
import Navigation from './Navigation.astro';

interface Props {
  activeLink?: 'portfolio' | 'blog';
}

const { activeLink } = Astro.props;
---

<Navigation active={activeLink === 'blog' ? 'blog' : undefined} contactHref="/#contact" />
